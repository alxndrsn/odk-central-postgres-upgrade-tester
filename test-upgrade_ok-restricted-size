#!/bin/bash -eu

# Test that an upgrade succeeds when the postgres14 volume is
# restricted to less than double the expected total space of the data
# for that volume.

# Extra blob: 250 MB; allow for double that.
restrictedVolumeSize=500

. ./lib.bash
setup_standard

log "Creating a massive blob..."
blobRes="$(exec_in_service_container create-blob.js)"
if ! [[ "$blobRes" = ok ]]; then
  log "!!! Failed to create massive blob!"""
  exit 1
fi

log "Upgrading central..." # see: https://docs.getodk.org/central-upgrade/
git_checkout "$TARGET_BRANCH"

log "Rebuilding and restarting containers..."
rebuild_and_restart_containers

confirm_postgres_version "$TARGET_BRANCH"
confirm_seed_data
confirm_postgres_version "$TARGET_BRANCH"
confirm_backend_running_ok
log "Containers rebuilt and restarted OK."

if ! [[ -f ./files/postgres14/upgrade/upgrade-successful ]]; then
  log "!!!"
  log "!!! ERROR: Upgrade success flag file not found!"
  log "!!!"
  exit 1
fi

log "Upgrade completed OK!"
