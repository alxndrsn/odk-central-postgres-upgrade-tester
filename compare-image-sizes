#!/bin/bash -eu
set -o pipefail

mb1=123
mb2=456

bytes1=123456789
bytes2=987654321

diffMb=385

# Append to GitHub Step Summary if running in GHA
if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
  {
    echo "## 📊 Image Size Comparison Report"
    echo ""
    echo "- **Group 1 Footprint (Postgres 14.24):** ${mb1} MB (\`${bytes1}\` bytes)"
    echo "- **Group 2 Footprint (PGAutoUpgrade 18.4):** ${mb2} MB (\`${bytes2}\` bytes)"
    echo "- **Net Impact (Group 2 - Group 1):** \`${diffMb} MB\`"
  } >> "$GITHUB_STEP_SUMMARY"
fi
