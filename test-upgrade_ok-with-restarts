#!/bin/bash -eu

# Test that a successful upgrade will cause a specific file to be
# created in the shared migration-logs directory, and that data
# is not lost if the host-side flag files are lost.



. ./lib.bash
setup_standard

log "Upgrading central..." # see: https://docs.getodk.org/central-upgrade/
git_checkout "$TARGET_BRANCH"

# massive blob not required
#

log "Rebuilding and restarting containers..."
rebuild_and_restart_containers

confirm_postgres_version "$TARGET_BRANCH"
confirm_seed_data
confirm_postgres_version "$TARGET_BRANCH"
confirm_backend_running_ok
log "Containers rebuilt and restarted OK."

if ! [[ -f ./files/postgres14/upgrade/upgrade-successful ]]; then
  log "!!!"
  log "!!! ERROR: Upgrade success flag file not found!"
  log "!!!"
  exit 1
fi

log "Restarting containers..."
test_restart "$TARGET_BRANCH"
log "Containers restarted OK."

log "Cleaning local upgrade flags..."
git clean -dfx -- files/postgres14/upgrade
log "Restarting containers after git-clean..."
log_cleaned_restart_fail() {
  log "!!!"
  log "!!! Restart failed after local upgrade flags were cleaned."
  log "!!!"
}
trap log_cleaned_restart_fail EXIT
test_restart "$TARGET_BRANCH"
trap - EXIT
log "Containers restarted OK."

log "Upgrade completed OK!"
