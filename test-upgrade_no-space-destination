#!/bin/bash -eu

# Test that running out of disk space during the upgrade stage is
# communicated via the upgrade log file.

. ./lib.bash

# FIXME testing that this test will FAIL without volume restriction
# FIXME remove this commenting to revert to the correct behaviour.
#log "Restricting target volume size..."
#restrictedVolumeSize=1

setup_standard

log "Upgrading central..." # see: https://docs.getodk.org/central-upgrade/
git_checkout "$TARGET_BRANCH"

rebuild_and_restart_containers || true

if docker compose up --detach --wait postgres; then
  log "!!!"
  log "!!! 'postgres' container should not have started OK!"
  log "!!!"
  exit 1
fi

log "Checking backend has started, but we don't realllllly want it to."
if _confirm_backend_running_ok 15; then
  log "!!!"
  log "!!! 'service' started OK, but should be stuck in a startup loop !!!"
  log "!!!"
  exit 1
fi

upgradeLogFile="./files/postgres14/upgrade/upgrade-postgres.log"
if ! grep -E 'UTC .* FATAL: .*: No space left on device$' "$upgradeLogFile"; then
  log "------------------ $upgradeLogFile ------------------"
  cat "$upgradeLogFile"
  log "-------------------------------------------------------"
  log "!!!"
  log "!!! Upgrade failed for unexpected reason!  Please review logs above."
  log "!!!"
  exit 1
fi

log "Test passed OK!"
