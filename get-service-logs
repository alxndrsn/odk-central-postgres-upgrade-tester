#!/bin/bash -eu
name="$1"

log() { echo >&2 "[get-service-logs|$name] $*"; }

log "---"
log "Fetching logs..."
docker logs --timestamps "central-${name}-1" || true

if [[ "$name" = postgres14 ]]; then
  log "---"
  log "Fetching upgrade crash logs..."
  docker run \
      --rm \
      --volume central_postrgres14:/vol:ro \
      alpine \
          find /vol \
              -path '*/pg_upgrade_output.d/*' \
              -name '*.log' \
              -exec tail --verbose -n 40 {} +
fi
log "---"
