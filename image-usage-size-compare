#!/bin/bash -eu
set -o pipefail

log() { echo "[$0|$(date +%Y-%m-%dT%H:%M:%S.%3N)] $*"; }

# Explicitly cleanup lingering containers at script startup
docker rm -f dind-test >/dev/null 2>&1 || true

# Auto-detect CI environment
if [ "${GITHUB_ACTIONS:-false}" = "true" ]; then
  log "--> CI environment detected: Running clean test without local volume cache." >&2
  VOLUME_FLAG=""
else
  CACHE_VOL="dind-image-cache"
  docker volume create "$CACHE_VOL" >/dev/null
  VOLUME_FLAG="-v ${CACHE_VOL}:/var/lib/docker"
fi

# Ensure DinD daemon is running continuously across both test groups
if ! docker exec dind-test docker info >/dev/null 2>&1; then
  docker rm -f dind-test >/dev/null 2>&1 || true
  docker run --rm --privileged \
    --name "dind-test" \
    ${VOLUME_FLAG} \
    -d docker:dind >/dev/null

  until docker exec dind-test docker info >/dev/null 2>&1; do
    sleep 0.2
  done
fi

measure_group() {
  local group_name="$1"
  shift
  local images=("$@")

  log "=== Measuring $group_name ===" >&2

  # Pull target group (skips network handshake if cached locally)
  for img in "${images[@]}"; do
    if docker exec dind-test docker image inspect "$img" >/dev/null 2>&1; then
      log "  $img present locally, skipping pull." >&2
    else
      log "  Pulling $img..." >&2
      docker exec dind-test docker pull "$img"
    fi
  done

  # Deduplicate RootFS layers across all images in group to get exact uncompressed footprint
  TOTAL_BYTES=$(docker exec dind-test docker inspect "${images[@]}" --format '{{range .RootFS.Layers}}{{.}}
{{end}}' | sort -u | xargs -I {} docker exec dind-test docker inspect --format '{{.Size}}' {} 2>/dev/null | gawk '{s+=$1} END {print s}')

  # Return MB on stdout
  echo $(( TOTAL_BYTES / 1024 / 1024 ))
}

# Image Arrays
BASE_IMAGES=(
  "node:24.20.0-slim"
  "jonasal/nginx-certbot:6.2.0-nginx1.31.5"
  "ghcr.io/enketo/enketo:7.6.4"
  "tianon/postgres-upgrade:9.6-to-14"
  "registry.gitlab.com/egos-tech/smtp:2.0.7"
  "ghcr.io/getodk/pyxform-http:v4.5.0"
  "redis:8.10.1"
)

GROUP1_IMAGES=("${BASE_IMAGES[@]}" "postgres:14.24")
GROUP2_IMAGES=("${BASE_IMAGES[@]}" "pgautoupgrade/pgautoupgrade:18.4-trixie")

# Execution
USAGE1=$(measure_group "Group 1 (Postgres 14.24)" "${GROUP1_IMAGES[@]}")
USAGE2=$(measure_group "Group 2 (PGAutoUpgrade 18.4)" "${GROUP2_IMAGES[@]}")

# Cleanup DinD daemon after measurements complete
docker kill dind-test >/dev/null 2>&1 || true

log ""
log "======================================"
log "Group 1 Total Footprint: ${USAGE1} MB"
log "Group 2 Total Footprint: ${USAGE2} MB"
log "======================================"
log "Difference (Group 2 - Group 1): $(( USAGE2 - USAGE1 )) MB"
