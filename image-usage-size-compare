#!/bin/bash -eu
set -o pipefail

# Helper function to test a set of images in an isolated Docker daemon
measure_group() {
  local group_name="$1"
  shift
  local images=("$@")

  echo "=== Measuring $group_name ==="

  # Run a temporary isolated Docker daemon inside a container
  docker run --rm --privileged \
    --name "dind-test" \
    -d docker:dind >/dev/null

  # Wait for the nested daemon to start
  until docker exec dind-test docker info >/dev/null 2>&1; do
    sleep 0.5
  done

  # Record baseline storage used inside the isolated daemon
  BEFORE=$(docker exec dind-test df -k /var/lib/docker | awk 'NR==2 {print $3}')

  # Pull and start containers for the group
  for img in "${images[@]}"; do
    echo "  Pulling $img..."
    docker exec dind-test docker pull "$img" >/dev/null
    # Optional: Spin container up if you want to capture writable layer growth
    # docker exec dind-test docker run -d "$img" >/dev/null
  done

  # Record storage after setup
  AFTER=$(docker exec dind-test df -k /var/lib/docker | awk 'NR==2 {print $3}')

  # Stop and remove the isolated daemon container completely
  docker kill dind-test >/dev/null 2>&1 || true

  # Return net MB used
  echo $(( (AFTER - BEFORE) / 1024 ))
}

# Common base images shared across both groups
BASE_IMAGES=(
  "node:24.20.0-slim"
  "jonasal/nginx-certbot:6.2.0-nginx1.31.5"
  "ghcr.io/enketo/enketo:7.6.4"
  "tianon/postgres-upgrade:9.6-to-14"
  "registry.gitlab.com/egos-tech/smtp:2.0.7"
  "ghcr.io/getodk/pyxform-http:v4.5.0"
  "redis:8.10.1"
)

# Group 1: Base + postgres:14.24
GROUP1_IMAGES=(
  "${BASE_IMAGES[@]}"
  "postgres:14.24"
)

# Group 2: Base + pgautoupgrade/pgautoupgrade:18.4-trixie
GROUP2_IMAGES=(
  "${BASE_IMAGES[@]}"
  "pgautoupgrade/pgautoupgrade:18.4-trixie"
)

# Run measurements
USAGE_GROUP1=$(measure_group "Group 1 (X, Y, Z)" "${GROUP1_IMAGES[@]}")
USAGE_GROUP2=$(measure_group "Group 2 (W, Y, Z)" "${GROUP2_IMAGES[@]}")

# Print Results
echo ""
echo "======================================"
echo "Group 1 Usage: ${USAGE_GROUP1} MB"
echo "Group 2 Usage: ${USAGE_GROUP2} MB"
echo "======================================"

DIFF=$(( USAGE_GROUP1 - USAGE_GROUP2 ))
echo "Difference (Group 1 - Group 2): ${DIFF} MB"
