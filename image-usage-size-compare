#!/bin/bash -eu
set -o pipefail

# Auto-detect CI environment
if [ "${GITHUB_ACTIONS:-false}" = "true" ]; then
  echo "--> CI environment detected: Running clean test without local volume cache." >&2
  VOLUME_FLAG=""
else
  CACHE_VOL="dind-image-cache"
  docker volume create "$CACHE_VOL" >/dev/null
  VOLUME_FLAG="-v ${CACHE_VOL}:/var/lib/docker"
fi

measure_group() {
  local group_name="$1"
  shift
  local images=("$@")

  echo "=== Measuring $group_name ===" >&2

  # Launch isolated DinD daemon
  docker run --rm --privileged \
    --name "dind-test" \
    ${VOLUME_FLAG} \
    -d docker:dind >/dev/null

  until docker exec dind-test docker info >/dev/null 2>&1; do
    sleep 0.2
  done

  # Pull all images required for this group
  for img in "${images[@]}"; do
    echo "  Ensuring $img is present..." >&2
    docker exec dind-test docker pull "$img" >/dev/null
  done

  # Sum the actual uncompressed size on disk for ONLY the images in this group
  # (handles shared layers properly within the docker daemon)
  TOTAL_BYTES=0
  for img in "${images[@]}"; do
    BYTES=$(docker exec dind-test docker inspect "$img" --format='{{.Size}}')
    TOTAL_BYTES=$(( TOTAL_BYTES + BYTES ))
  done

  docker kill dind-test >/dev/null 2>&1 || true

  # Convert Bytes to MB
  echo $(( TOTAL_BYTES / 1024 / 1024 ))
}

# Image Arrays
BASE_IMAGES=(
  "node:24.20.0-slim"
  "jonasal/nginx-certbot:6.2.0-nginx1.31.5"
  "ghcr.io/enketo/enketo:7.6.4"
  "tianon/postgres-upgrade:9.6-to-14"
  "registry.gitlab.com/egos-tech/smtp:2.0.7"
  "ghcr.io/getodk/pyxform-http:v4.5.0"
  "redis:8.10.1"
)

GROUP1_IMAGES=("${BASE_IMAGES[@]}" "postgres:14.24")
GROUP2_IMAGES=("${BASE_IMAGES[@]}" "pgautoupgrade/pgautoupgrade:18.4-trixie")

# Execution
USAGE1=$(measure_group "Group 1 (Postgres 14.24)" "${GROUP1_IMAGES[@]}")
USAGE2=$(measure_group "Group 2 (PGAutoUpgrade 18.4)" "${GROUP2_IMAGES[@]}")

echo ""
echo "======================================"
echo "Group 1 Total Footprint: ${USAGE1} MB"
echo "Group 2 Total Footprint: ${USAGE2} MB"
echo "======================================"
echo "Difference (Group 1 - Group 2): $(( USAGE1 - USAGE2 )) MB"