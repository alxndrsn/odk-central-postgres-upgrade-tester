#!/bin/bash -eu
name="$1"

log() { echo >&2 "[logs-and-exit-for|$name] $*"; }

log "Fetching logs..."
docker logs --timestamps "central-${name}-1"

log "Getting container hash..."
hash="$(docker ps | awk '$2 ~ "central-'"$name"'" { print $1 }')"
if [[ -z "$hash" ]]; then
  log "No hash found; skipping check of exit code."
else
  exitCode="$(docker inspect "$hash" --format='{{.State.ExitCode}}')"
  exit "$exitCode"
fi
