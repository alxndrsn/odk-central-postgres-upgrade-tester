#!/bin/bash -eu

. ./lib.bash

# Handle upgrades after postgres14 container failed to shutdown cleanly.
if ! [[ "$INITIAL_BRANCH" =~ upgrade-pg-14- ]]; then
  log "!!!"
  log "!!! This test is only relevant when starting from a v14 release."
  log "!!!"
  log "!!! Try e.g."
  log "!!!"
  log "!!!     INITIAL_BRANCH=upgrade-pg-14-official-next ..."
  log "!!!"
  exit 1
fi
if ! [[ "$TARGET_BRANCH" =~ upgrade-pg-((1[7-9])|(2[0-9])) ]]; then
  log "!!!"
  log "!!! This test is only relevant when targeting a pgautoupgrade-backed version."
  log "!!!"
  log "!!! Try e.g."
  log "!!!"
  log "!!!     TARGET_BRANCH=upgrade-pg-17 ..."
  log "!!!     TARGET_BRANCH=upgrade-pg-18 ..."
  log "!!!"
  exit 1
fi

# The PID of the postgres process is _usually_ 12, although it's sometimes 11 or 13.
stalePid=12

setup_standard

container="central-postgres14-1"

log "Killing progress to force unclean shutdown..."
docker kill --signal KILL "$container"
docker wait "$container"

img="$(docker inspect --format '{{.Image}}' "$container")"
docker run \
    --rm \
    --user postgres \
    --volume central_postgres14:/vol \
    --entrypoint sed \
    "$img" \
    -E "s/.*/$stalePid/" /vol/data/postmaster.pid

log "Upgrading central..."
git_checkout "$TARGET_BRANCH"

log "Rebuilding and restarting containers..."
rebuild_and_restart_containers

confirm_postgres_target_version "$TARGET_BRANCH"
confirm_seed_data

finalPid="$(docker exec "$container" bash -c 'cat "$PGDATA"/postmaster.pid')"
if ! [[ "$finalPid" = "$stalePid" ]]; then
  log "!!!"
  log "!!! PID mismatch, so PID collision was never tested."
  log "!!!"
  log "!!!   stalePid: $stalePid"
  log "!!!   finalPid: $finalPid"
  log "!!!"
  log "!!! This is expected ~10% of the time.  Please re-run the job."
  exit 1
fi

log "Upgrade completed OK!"
